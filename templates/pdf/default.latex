\documentclass[a4paper]{article}
\usepackage{amsmath,amssymb}
\usepackage{iftex}
\ifPDFTeX
  \usepackage[T1]{fontenc}
  \usepackage[utf8]{inputenc}
\else
  \usepackage{fontspec}
  $if(mainfont)$
  \setmainfont{$mainfont$}
  \setsansfont{$mainfont$}
  $endif$
\fi
\usepackage{xcolor}
\definecolor{rytvrule}{HTML}{0B3A66}
\definecolor{rytvheading}{HTML}{282828}
\definecolor{rytvlink}{HTML}{0B3A66}
\usepackage{geometry}
\geometry{margin=2.2cm,includehead,includefoot}
\usepackage{graphicx}
\usepackage{longtable,booktabs,array,calc}
\usepackage{parskip}
\usepackage{fancyhdr}
\usepackage{hyperref}
\usepackage{bookmark}
\hypersetup{colorlinks=true,linkcolor=rytvlink,urlcolor=rytvlink,filecolor=rytvlink}
\makeatletter
\define@key{Gin}{alt}{}
\newsavebox\pandoc@box
\newcommand*\pandocbounded[1]{%
  \sbox\pandoc@box{#1}%
  \Gscale@div\@tempa{\textheight}{\dimexpr\ht\pandoc@box+\dp\pandoc@box\relax}%
  \Gscale@div\@tempb{\linewidth}{\wd\pandoc@box}%
  \ifdim\@tempb\p@<\@tempa\p@\let\@tempa\@tempb\fi
  \ifdim\@tempa\p@<\p@\scalebox{\@tempa}{\usebox\pandoc@box}%
  \else\usebox{\pandoc@box}%
  \fi
}
\renewcommand\section{\@startsection{section}{1}{\z@}%
  {-3.5ex plus -1ex minus -.2ex}{2.3ex plus .2ex}%
  {\normalfont\Large\bfseries\color{rytvheading}}}
\renewcommand\subsection{\@startsection{subsection}{2}{\z@}%
  {-3.25ex plus -1ex minus -.2ex}{1.5ex plus .2ex}%
  {\normalfont\large\bfseries\color{rytvheading}}}
\makeatother
\providecommand{\tightlist}{\setlength{\itemsep}{0pt}\setlength{\parskip}{0pt}}
\pagestyle{fancy}
\fancyhf{}
\renewcommand{\headrulewidth}{0.4pt}
\renewcommand{\footrulewidth}{0.2pt}
\fancyhead[L]{$title$}
$if(version)$
\fancyhead[R]{$version$}
$endif$
\fancyfoot[C]{\thepage}
\fancypagestyle{plain}{%
  \fancyhf{}
  \fancyfoot[C]{\thepage}
  \renewcommand{\headrulewidth}{0pt}
}
\begin{document}
\begin{titlepage}
\thispagestyle{empty}
\vspace*{1.5cm}
{\color{rytvrule}\rule{\textwidth}{4pt}\par}
\vspace{1.2em}
{\sffamily\bfseries\Huge $title$\par}
$if(version)$
\vspace{1em}
{\Large $version$\par}
$endif$
\vfill
\end{titlepage}
$body$
\end{document}
